PORT=3000

# Required: change these before putting the site online.
ADMIN_PASSWORD=change-me
ADMIN_SECRET=replace-with-a-long-random-string

# Postgres connection. Use ONE of the two options below.

# Option A (recommended, works with Neon/Supabase/Railway/Render and any
# other hosted Postgres): a single connection string, usually copy-pasted
# straight from your provider's dashboard.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B (local Postgres only — will NOT work once deployed to Vercel,
# since "localhost" there means Vercel's own machine, not yours):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-local-password
PGDATABASE=Portfolio
